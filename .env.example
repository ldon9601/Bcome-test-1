# --- Database: Supabase project in the Sydney (ap-southeast-2) region -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose to the browser. Leave both blank to run locally with an in-memory demo school.
SUPABASE_SERVICE_ROLE_KEY=

# --- Accounts -----------------------------------------------------------------------------------
# Random secret (at least 32 characters) used to key one-time email codes: `openssl rand -base64 48`
AUTH_SECRET=
# Public address of the app, used in invitation links.
APP_URL=https://bcome.example
# "manual" (default with a database): new schools wait for approval (npm run school -- approve <id>).
# "auto": schools are active immediately. Use only for testing.
SCHOOL_APPROVAL=manual
# Optional: email domain endings accepted for schools (default .edu.au,.gov.au).
# SCHOOL_DOMAIN_SUFFIXES=.edu.au,.gov.au
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@bcome.example

# --- Email (sign-in codes, invitations) ---------------------------------------------------------
# ses (recommended: Amazon SES in Sydney keeps email processing in Australia), resend, or console (development only).
EMAIL_PROVIDER=ses
EMAIL_FROM=Bcome <no-reply@bcome.example>
AWS_SES_REGION=ap-southeast-2
# IAM user limited to ses:SendEmail on your verified domain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# RESEND_API_KEY=

# --- AI plan writer -----------------------------------------------------------------------------
# Leave blank to always use the offline template writer. Schools also switch AI plans on or off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "off" to stop AI plans for people using Bcome without an account.
GUEST_AI_PLANS=on
