    {
      "id": "about",
      "title": "About you",
      "intro": "A few quick questions so we can tailor your results. These don't affect your scores."
    },
    {
      "id": "interests",
      "title": "Section A: Interests",
      "intro": "How much would you enjoy doing this activity, regardless of whether you think you're currently good at it?"
    },
    {
      "id": "strengths",
      "title": "Section B: Current skill confidence",
      "intro": "Compared with activities you normally do at school and outside school, how confident are you doing the following?"
    },
    {
      "id": "values",
      "title": "Section C: Work values",
      "intro": "Imagine you're 25 and choosing between two otherwise similar jobs. How important would each of these things be?"
    },
    {
      "id": "environment",
      "title": "Section D: Preferred work environment",
      "intro": "There are no right answers. Go with your first instinct."
    },
    {
      "id": "school",
      "title": "Section E: School and education pathway",
      "intro": "Nothing here is locked in. You can update it at your next check-in."
    }
